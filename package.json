{
	"name": "affibloom",
	"version": "1.0.0",
	"private": true,
	"license": "GPL-2.0-or-later",
	"files": [
		"affibloom.php",
		"uninstall.php",
		"readme.txt",
		"src",
		"templates",
		"assets",
		"build",
		"data",
		"resources",
		"composer.json",
		"vendor",
		"languages"
	],
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"wp": "wp-env run cli wp",
		"test:e2e": "playwright test",
		"reset-local": "bash tools/reset-local.sh",
		"test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/affibloom vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"build": "wp-scripts build --webpack-src-dir=blocks --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=blocks --output-path=build",
		"lint:js": "wp-scripts lint-js blocks assets/editor",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "^37.1.0"
	}
}
