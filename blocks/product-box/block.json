{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "affibloom/product-box",
	"title": "Affibloom",
	"category": "widgets",
	"description": "Shows a product, a group or a table as a display in your post.",
	"textdomain": "affibloom",
	"keywords": [
		"product box",
		"link",
		"affiliate",
		"product",
		"display"
	],
	"attributes": {
		"type": {
			"type": "string",
			"default": ""
		},
		"productId": {
			"type": "number",
			"default": 0
		},
		"groupId": {
			"type": "number",
			"default": 0
		},
		"tableId": {
			"type": "number",
			"default": 0
		},
		"overrides": {
			"type": "object",
			"default": {}
		},
		"badge": {
			"type": "string",
			"default": ""
		},
		"hideBadge": {
			"type": "boolean",
			"default": false
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"hideDescription": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"hideTitle": {
			"type": "boolean",
			"default": false
		},
		"titleUrl": {
			"type": "string",
			"default": ""
		},
		"titleType": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"hideImage": {
			"type": "boolean",
			"default": false
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": ""
		},
		"primaryUrl": {
			"type": "string",
			"default": ""
		},
		"primaryText": {
			"type": "string",
			"default": ""
		},
		"secondaryUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryText": {
			"type": "string",
			"default": ""
		},
		"trackingId": {
			"type": "string",
			"default": ""
		},
		"disclosureText": {
			"type": "string",
			"default": ""
		},
		"anchorId": {
			"type": "string",
			"default": ""
		},
		"linkId": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": ""
		},
		"price": {
			"type": "string",
			"default": ""
		},
		"basisPrice": {
			"type": "string",
			"default": ""
		},
		"rating": {
			"type": "string",
			"default": ""
		},
		"pros": {
			"type": "string",
			"default": ""
		},
		"cons": {
			"type": "string",
			"default": ""
		},
		"prosLabel": {
			"type": "string",
			"default": ""
		},
		"consLabel": {
			"type": "string",
			"default": ""
		},
		"fields": {
			"type": "string",
			"default": ""
		},
		"prime": {
			"type": "boolean",
			"default": false
		},
		"showProsCons": {
			"type": "boolean"
		},
		"schemaReview": {
			"type": "boolean",
			"default": false
		},
		"schemaProsCons": {
			"type": "boolean",
			"default": false
		},
		"schemaPrice": {
			"type": "string",
			"default": ""
		},
		"schemaPriceCurrency": {
			"type": "string",
			"default": ""
		},
		"sitestripe": {
			"type": "boolean",
			"default": false
		},
		"sitestripeStyle": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
