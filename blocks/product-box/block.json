{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "affibloom/product-box",
	"title": "Product box",
	"category": "widgets",
	"description": "Shows one product's box.",
	"textdomain": "affibloom",
	"attributes": {
		"productId": {
			"type": "number",
			"default": 0
		},
		"badge": {
			"type": "string",
			"default": ""
		},
		"hideBadge": {
			"type": "boolean",
			"default": false
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"hideDescription": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"hideTitle": {
			"type": "boolean",
			"default": false
		},
		"titleUrl": {
			"type": "string",
			"default": ""
		},
		"titleType": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"hideImage": {
			"type": "boolean",
			"default": false
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": ""
		},
		"primaryUrl": {
			"type": "string",
			"default": ""
		},
		"primaryText": {
			"type": "string",
			"default": ""
		},
		"secondaryUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryText": {
			"type": "string",
			"default": ""
		},
		"trackingId": {
			"type": "string",
			"default": ""
		},
		"disclosureText": {
			"type": "string",
			"default": ""
		},
		"anchorId": {
			"type": "string",
			"default": ""
		},
		"linkId": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	}
}
