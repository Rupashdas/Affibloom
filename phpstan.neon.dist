includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	# The result cache stays with the project, not in the system temp folder that gets cleared (deviation 131).
	tmpDir: .local/phpstan
	phpVersion: 80300
	scanFiles:
		- tests/stubs/wp-cli.php
		- tests/stubs/wp-cli-utils.php
		- tests/stubs/elementor.php
	paths:
		- affibloom.php
		- src
